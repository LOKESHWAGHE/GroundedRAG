# Copy this file to backend/.env and fill in LLM_API_KEY at minimum.
# Every value has a sensible default in app/core/config.py; only uncomment/
# change what you need.

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Database ---
# Local Postgres via docker compose (recommended):
DATABASE_URL=postgresql+psycopg2://grounded_rag:grounded_rag@localhost:5432/grounded_rag
# Zero-setup alternative for quick local testing (no Postgres needed):
# DATABASE_URL=sqlite:///./data/grounded_rag.db

# --- Storage ---
MAX_UPLOAD_SIZE_MB=25

# --- Chunking ---
CHUNK_SIZE_TOKENS=180
CHUNK_OVERLAP_TOKENS=30
CHUNK_STRATEGY=structure

# --- Embeddings / dense retrieval ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
DENSE_TOP_K=20

# --- BM25 ---
BM25_TOP_K=20
BM25_K1=1.5
BM25_B=0.75

# --- Hybrid fusion ---
RRF_K=60
HYBRID_TOP_N=20

# --- Reranking ---
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_M=5
CONTEXT_MAX_WORDS=1200

# --- LLM ---
# LLM_PROVIDER: anthropic | openai | extractive (extractive needs no key — see README)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=your-api-key-here
# LLM_BASE_URL is only needed for LLM_PROVIDER=openai against a non-OpenAI
# OpenAI-compatible server, e.g. a local Ollama instance:
# LLM_BASE_URL=http://localhost:11434/v1

# --- Claim extraction & verification ---
CLAIM_EXTRACTION_MODE=llm
NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-small
SUPPORT_THRESHOLD=0.70
PARTIAL_THRESHOLD=0.30
CONTRADICTION_THRESHOLD=0.50
MAX_REGENERATION_RETRIES=2

# --- Startup ---
# Set true to load the embedding/reranker/NLI models at server startup
# instead of on first request (slower startup, faster first query):
PRELOAD_MODELS=false
